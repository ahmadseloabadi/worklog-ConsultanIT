# Client ID OAuth Google (tipe "Web application"). Nilai ini PUBLIK, bukan rahasia.
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Opsional: batasi login ke domain email tertentu (tanpa @). Hanya pembatas di sisi tampilan;
# keamanan data sebenarnya dijaga oleh izin Google pada spreadsheet dan folder.
VITE_ALLOWED_EMAIL_DOMAIN=
